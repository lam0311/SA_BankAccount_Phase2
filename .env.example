DB_USER=your_db_user
DB_PASSWORD=your_password_here
DB_NAME=your_database_name
DB_PORT=5432
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}?schema=public"
DOCKER_DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}?schema=public"
APP_PORT=3000
NODE_ENV=production

# Auth & Security
JWT_ACCESS_SECRET=your_super_secret_key_at_least_32_characters_long
JWT_ACCESS_TTL=60m
BCRYPT_ROUNDS=12
# Optional: defaults to max(1, availableParallelism() - 1) to reserve 1 core for the Event Loop
# BCRYPT_MAX_THREADS=3
BCRYPT_MAX_QUEUE=100
BCRYPT_HIGH_TRAFFIC_THRESHOLD=10
EVENT_LOOP_MONITOR_INTERVAL_MS=0
